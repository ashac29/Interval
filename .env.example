# Interval — environment variables. Placeholders only; never commit real secrets.
# Everything is OPTIONAL: with none set the app runs in demo mode (deterministic mock AI,
# fixture calendar, simulated commerce, preview-only email).

# ── App ──────────────────────────────────────────────
# Public base URL (used to build OAuth redirect URIs). Falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# then to the request origin. Set explicitly in production, e.g. https://interval.example.com
NEXT_PUBLIC_APP_URL=

# ── Supabase (auth + live storage). Missing → login is disabled, demo only. ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed by background jobs and privileged operations. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar (read-only). Missing → "Connect Google Calendar" explains it is unavailable. ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact override; default is <app url>/api/calendar/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Random 32+ byte secret for signing OAuth state (openssl rand -base64 32)
OAUTH_STATE_SECRET=
# base64 of 32 random bytes for AES-256-GCM refresh-token encryption (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# ── LLM. Missing key → deterministic mock AI, labeled as demo AI. ──
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Default https://api.anthropic.com (this is NOT the ANTHROPIC_BASE_URL dev-tool variable)
LLM_API_BASE_URL=
ANTHROPIC_API_KEY=

# ── Email (opt-in reminders). none → previews only, never reported as sent. ──
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=Interval <reminders@example.com>

# ── Jobs. Bearer secret required by /api/jobs/run (set the same value in Vercel Cron). ──
CRON_SECRET=

# ── Calendar sync ────────────────────────────────────
CALENDAR_SYNC_INTERVAL_MINUTES=60
CALENDAR_PAST_DAYS=7
CALENDAR_FUTURE_DAYS=14

# ── Product data ─────────────────────────────────────
# Operator-VERIFIED caffeine per can. Leave empty until lab-verified; unknown caffeine blocks suggestions.
# Example: {"chai":{"mg":40,"status":"verified"},"oolong":{"mg":30,"status":"verified"},"matcha":{"mg":35,"status":"verified"}}
PRODUCT_CAFFEINE_JSON=

# ── Demo ─────────────────────────────────────────────
# memory (per-instance, ephemeral) or supabase (durable demo sessions table)
DEMO_STORE=memory
